# Copy to .env (never commit .env). Environment variables already set by the OS win.

# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# ---- Model provider (first configured wins: Gemini -> Groq -> CloseRouter -> Anthropic) ----
# Without any key the app still runs on the deterministic rules-only path and every
# result is labelled "AI assessment unavailable".

# Gemini direct - Google AI Studio free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash       # free tier: 20 requests/day per key
# GEMINI_API_KEY_POOL=key1,key2      # optional: rotate keys when one hits the free-tier quota (429)
# GEMINI_RPM=10                      # requests/minute per key; calls are spaced to stay under it

# Groq (OpenAI-compatible) - free tier: ~1000 requests/day, 8000 tokens/min per model
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b       # batches all tool calls in one turn; gpt-oss-120b calls one tool per turn (~3x the tokens)
# LLM_RPM=30                         # pacing for Groq / CloseRouter (requests per minute)
# LLM_TPM=8000                       # pacing for Groq / CloseRouter (tokens per minute)
# LLM_MAX_RETRY_WAIT=90              # longer server-requested waits = quota exhausted -> fail fast

# Gemini through CloseRouter (OpenAI-compatible endpoint)
# CLOSEROUTER_API_KEY=
# CLOSEROUTER_MODEL=google/gemini-3.7-flash
# CLOSEROUTER_BASE_URL=https://api.closerouter.dev/v1

# Anthropic (optional)
# ANTHROPIC_API_KEY=
# MODEL_NAME=claude-opus-5-5
# COPILOT_EFFORT=low

# Force a provider instead of auto-detect: gemini | groq | closerouter | anthropic
# LLM_PROVIDER=gemini

# Runtime limits
# COPILOT_MAX_TURNS=6                # agent tool-loop cap before degrading to rules-only
# COPILOT_LLM_TIMEOUT=120            # seconds per model call
# COPILOT_LLM=off                    # force rules-only mode
